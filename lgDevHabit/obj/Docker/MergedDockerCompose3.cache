name: dockercompose15304095483720582189
services:
  lgdevhabit.api:
    build:
      context: D:\Csharp20241101\day0415\lgDevHabit
      dockerfile: lgDevHabit.Api/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      OTEL_EXPORTER_OTLP_ENDPOINT: http://lgdevhabit.aspire-dashboard:18889
      OTEL_EXPORTER_OTLP_PROTOCOL: grpc
    image: lgdevhabitapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\HFY\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HFY\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HFY\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\HFY\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  lgdevhabit.aspire-dashboard:
    environment:
      DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS: "true"
    image: mcr.microsoft.com/dotnet/aspire-dashboard:9.0
    networks:
      default: null
    ports:
      - mode: ingress
        target: 18888
        published: "18888"
        protocol: tcp
  lgdevhabit.postgres:
    environment:
      POSTGRES_DB: lgdevhabit
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:17.2
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: D:\Csharp20241101\day0415\lgDevHabit\.containers\postgres_data
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose15304095483720582189_default